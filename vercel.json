{
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/answers",
      "destination": "/answers/",
      "permanent": true
    },
    {
      "source": "/services.html",
      "destination": "/#platforms",
      "permanent": true
    },
    {
      "source": "/pricing.html",
      "destination": "/#pricing",
      "permanent": true
    },
    {
      "source": "/contact.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/answers/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
